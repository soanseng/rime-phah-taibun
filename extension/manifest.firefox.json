{
  "manifest_version": 2,
  "name": "寫台文 Siá Tâi-bûn 輸入法",
  "short_name": "寫台文",
  "description": "佇任何網頁輸入框直接拍台文：漢羅／全羅輸出、TL／POJ 拼音攏會使換。",
  "version": "0.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "寫台文輸入法",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-ime": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "開／關寫台文輸入"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keys.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "phah-taibun@taigi.anatomind.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
